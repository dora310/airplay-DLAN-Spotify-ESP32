# Default values

# PSRAM support
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Conservative flash settings matching the known-working ESP32-S3 image.
# DIO is slower than QIO but is compatible with more ESP32-S3-WROOM-1 modules.
# Keep these values explicit so a clean CI build cannot select QIO.
# CONFIG_ESPTOOLPY_FLASHMODE_QIO is not set
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# WiFi
CONFIG_DEFAULT_AP_SSID="AirPlay and DLNA Setup"
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# libsodium: disable mbedTLS SHA wrapper — ESP32 hardware SHA acceleration
# is incompatible with libsodium's state management pattern.
# (The Kconfig guard for this was removed in libsodium 1.0.21)
CONFIG_LIBSODIUM_USE_MBEDTLS_SHA=n

# mDNS
CONFIG_MDNS_MAX_SERVICES=10
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# mbedTLS: use default allocator so RSA MPI buffers can spill to SPIRAM
# when internal DRAM is tight (audio task stacks pre-allocated there).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# LWIP - increase socket limits for AirPlay
CONFIG_LWIP_MAX_SOCKETS=16

# Enable SO_RCVBUF so the buffered-audio socket can use a small receive
# buffer.  We do our own jitter buffering in audio_buffer; the kernel
# should hold no more than a couple of MSS so back-pressure to the
# sender is responsive when our PCM ring runs full.
CONFIG_LWIP_SO_RCVBUF=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions.csv"

# Compiler optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# HTTP server — limit open sockets to avoid LWIP socket exhaustion.
# Default is 7; with RTSP + audio + NTP + PTP + WiFi the budget is tight.
CONFIG_HTTPD_WS_SUPPORT=y

# Memory Tweaks
# Push allocations > 1024 bytes to SPIRAM, keeping internal DRAM free for
# semaphores, DMA descriptors and WiFi management structures that *must*
# live in internal DRAM.  Default is 16384 — far too aggressive
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# DLNA decoder support used by main/network/dlna_renderer.c
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=y
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=y
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=y
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=y
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=y
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
