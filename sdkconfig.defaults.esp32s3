# ESP32-S3 target defaults - default to ESP32-S3 Generic board
CONFIG_BOARD_ESP32S3_GENERIC=y
CONFIG_DEFAULT_AP_SSID="AirPlay and DLNA Setup"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-16m.csv"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_SPOTIFY_CONNECT_ENABLE=y
CONFIG_SPOTIFY_CONNECT_BITRATE=160
CONFIG_AIRPLAY_TIMING_THRESHOLD_MS=20
# DLNA music and voice decoding
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=y
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=y
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=y
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=y
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=y
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=y

# USB Audio Class defaults for the current usb_device_uac integration.
# Keep both streams stereo at 48 kHz so the UAC descriptors, feedback,
# and AirPlay USB backend all use the same resampled output rate.
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000

# GPIO defaults
CONFIG_BAT_CHANNEL=7
CONFIG_LED_RGB_GPIO=48
CONFIG_LED_RGB_PLAYING_VU=y
CONFIG_I2S_SCK_IO=8
CONFIG_I2S_BCK_IO=11
CONFIG_I2S_WS_IO=13
CONFIG_I2S_DO_IO=12
CONFIG_I2S_GND_IO=14

# 2.0-inch GMT020-02 ST7789V TFT, 240x320 native / 320x240 landscape.
# The module labels its SPI clock and data pins SCL and SDA.
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_DRIVER_ST7789=y
CONFIG_DISPLAY_BUS_SPI=y
CONFIG_DISPLAY_SPI_CLK=18
CONFIG_DISPLAY_SPI_MOSI=17
CONFIG_DISPLAY_SPI_CS=15
CONFIG_DISPLAY_SPI_DC=16
CONFIG_DISPLAY_SPI_RST=21
# GMT020-02 has no BL header pin; its backlight is powered internally from VCC.
CONFIG_DISPLAY_BL_GPIO=-1
CONFIG_DISPLAY_ST7789_WIDTH=320
CONFIG_DISPLAY_ST7789_HEIGHT=240
CONFIG_DISPLAY_ST7789_GAP_X=0
CONFIG_DISPLAY_ST7789_GAP_Y=0
CONFIG_DISPLAY_UPDATE_MS=500

# LVGL configuration required by the ST7789 display component.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# The generated international font uses LVGL RLE-compressed glyph bitmaps.
# Without this option LVGL finds each Unicode glyph but returns no bitmap.
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_BIDI=y
CONFIG_LV_BIDI_DIR_AUTO=y
CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y
# Runtime FreeType is not used. International glyphs are compiled into
# components/display/fonts/lv_font_international_16.c.
CONFIG_LV_USE_FREETYPE=n
# R33 uses a private bounded TJpgDec worker to produce RGB565 before LVGL sees
# the image. Keep LVGL's direct JPEG decoder disabled: it was responsible for
# the moving white rectangle and unsafe compressed-buffer lifetime.
# CONFIG_LV_USE_TJPGD is not set
CONFIG_ENABLE_AIRPLAY_ARTWORK=y
CONFIG_AIRPLAY_ARTWORK_MAX_KB=256
#
# See components/display/README.md for full setup instructions.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
